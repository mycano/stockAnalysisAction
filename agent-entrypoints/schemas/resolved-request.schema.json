{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdvancingTitans/stock-analysis/agent-entrypoints/schemas/resolved-request.schema.json",
  "title": "ResolvedRequest",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_hash",
    "command_id",
    "command",
    "route",
    "workflow_id",
    "arguments",
    "argv",
    "reason_codes",
    "output_contract",
    "blocked",
    "block_reasons",
    "redirect"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "catalog_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_id": {"type": "string"},
    "command_id": {"type": "string", "pattern": "^stock-analysis\\."},
    "command": {"type": "string"},
    "route": {"type": ["string", "null"]},
    "workflow_id": {"type": ["string", "null"]},
    "arguments": {"type": "object"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_contract": {
      "type": ["object", "null"],
      "required": ["description", "stdout_required", "required_artifacts"],
      "properties": {
        "description": {"type": "string"},
        "stdout_required": {"type": "boolean"},
        "required_artifacts": {"type": "array", "items": {"type": "string"}},
        "required_sections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "blocked": {"type": "boolean"},
    "block_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "redirect": {
      "type": ["object", "null"],
      "required": ["from", "to", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "reason_code": {"type": "string"}
      }
    }
  }
}
